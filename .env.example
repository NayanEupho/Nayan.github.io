# Copy this file to .env. Never commit the resulting .env file.
ADMIN_PASSWORD=replace-with-at-least-8-characters

# Optional but recommended. Use a separate long random value so rotating the
# admin password does not also define the session-signing key.
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Set this to the exact public origin in production, including https://.
APP_ORIGIN=http://localhost:3000
