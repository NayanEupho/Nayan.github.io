# Copy this file to .env. Never commit the resulting .env file.
# The contact form uses Gmail SMTP. Create a Google App Password for the
# account and use that here; a normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=nayanmodicd@gmail.com
SMTP_PASS=replace-with-a-google-app-password
CONTACT_TO=nayanmodicd@gmail.com
CONTACT_FROM=nayanmodicd@gmail.com

# Set this to the exact public origin in production, including https://.
APP_ORIGIN=http://localhost:3000
